<Window
    x:Class="lab4_18.Pages.DeadlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DeadlinePage"
    Width="880"
    Height="560"
    WindowStartupLocation="CenterScreen" >

    <Window.Resources>
        <ResourceDictionary Source="../styles.xaml" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="16"/>   <!-- Spacer -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ===== Header: title + search/action ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="Дедлайни"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Перегляньте дедлайни за спеціальністю"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Поле вводу спеціальності -->
            <TextBox Grid.Column="1"
                     Height="36"
                     Padding="10,6"
                     Text="{Binding Specialty, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"/>

            <!-- Кнопка показу -->
            <Button Grid.Column="3"
                    Height="36"
                    Content="Show Deadlines"
                    Click="OnShowDeadlinesClick"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- ===== Content card with list ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceStrokeBrush}"
                BorderThickness="1"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- caption -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>   <!-- list -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Список дедлайнів:"/>

                <!-- ListView with modern item styling, no static colors -->
                <ListView Grid.Row="2"
                          ItemsSource="{Binding Deadlines}"
                          Margin="0"
                          AlternationCount="2">
                    <!-- Row/item styling -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <!-- Zebra rows -->
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                </Trigger>
                                <!-- Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <!-- Selected -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
                                </Trigger>
                                <!-- Disabled (safety) -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <!-- GridView columns -->
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Назва предмета" Width="380"
                                            DisplayMemberBinding="{Binding Subject}"/>
                            <GridViewColumn Header="Дата" Width="140"
                                            DisplayMemberBinding="{Binding Date}"/>
                            <GridViewColumn Header="Статус" Width="160"
                                            DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>

                    <!-- Порожній стан -->
                    <ListView.Style>
                        <Style TargetType="ListView">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListView">
                                                <Border Padding="24"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource SurfaceStrokeBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="Немає записів для відображення"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Style>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
