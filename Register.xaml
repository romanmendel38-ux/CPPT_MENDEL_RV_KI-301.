<Window
    x:Class="lab4_18.Register"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:lab4_18"
    mc:Ignorable="d"
    Title="Register"
    Width="520"
    Height="520"
    WindowStartupLocation="CenterScreen" >

    <Window.Resources>
        <ResourceDictionary Source="styles.xaml" />
    </Window.Resources>

    <Grid>
        <!-- Центрування картки -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Картка форми -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceStrokeBrush}"
                BorderThickness="1"
                Padding="28"
                SnapsToDevicePixels="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Header -->
                    <RowDefinition Height="20"/>    <!-- Spacer -->
                    <RowDefinition Height="Auto"/>   <!-- Form -->
                    <RowDefinition Height="20"/>    <!-- Spacer -->
                    <RowDefinition Height="Auto"/>   <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Створіть обліковий запис"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Заповніть поля нижче, щоб зареєструватися"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Форма -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Name -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/> <!-- Email -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/> <!-- Password -->
                    </Grid.RowDefinitions>

                    <!-- Name -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Text="Name"/>
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Width="260"
                             Height="32"
                             Padding="8,4"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             TabIndex="0"/>

                    <!-- Email -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Text="Email"/>
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Width="260"
                             Height="32"
                             Padding="8,4"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             TabIndex="1"/>

                    <!-- Password -->
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Text="Password"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Width="260"
                                 Height="32"
                                 Padding="8,4"
                                 VerticalAlignment="Center"
                                 TabIndex="2"/>
                </Grid>

                <!-- Дії -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Height="36"
                            Content="Go Back to Login"
                            Click="GoBackToLogin"
                            TabIndex="3"/>

                    <Button Grid.Column="2"
                            Height="36"
                            Content="Register"
                            Click="RegisterClick"
                            IsDefault="True"
                            TabIndex="4"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
