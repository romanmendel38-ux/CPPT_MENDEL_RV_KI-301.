<Window
    x:Class="lab4_18.Pages.UpdateInformation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Update Information"
    Width="520"
    Height="460"
    WindowStartupLocation="CenterScreen" >

    <Window.Resources>
        <ResourceDictionary Source="../styles.xaml" />
    </Window.Resources>

    <!-- Центруємо картку з формою -->
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Column="1"
                Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceStrokeBrush}"
                BorderThickness="1"
                Padding="24"
                SnapsToDevicePixels="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>  <!-- Form -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>  <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Оновлення даних"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Вкажіть актуальну інформацію про себе"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Форма -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Name -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>  <!-- Rating -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>  <!-- University -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>  <!-- Specialization -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>  <!-- Email -->
                    </Grid.RowDefinitions>

                    <!-- Name -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Ім'я" />
                    <TextBox   Grid.Row="0" Grid.Column="2" Height="32" Padding="8,4"
                               Text="{Binding Name}" />

                    <!-- Rating -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Рейтинг" />
                    <TextBox   Grid.Row="2" Grid.Column="2" Height="32" Padding="8,4"
                               Text="{Binding Rating}" />

                    <!-- University -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Університет" />
                    <TextBox   Grid.Row="4" Grid.Column="2" Height="32" Padding="8,4"
                               Text="{Binding University}" />

                    <!-- Specialization -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Спеціальність" />
                    <TextBox   Grid.Row="6" Grid.Column="2" Height="32" Padding="8,4"
                               Text="{Binding Specialization}" />

                    <!-- Email -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Пошта" />
                    <TextBox   Grid.Row="8" Grid.Column="2" Height="32" Padding="8,4"
                               Text="{Binding Email}" />
                </Grid>

                <!-- Дія -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Click="OkButton_Click"
                            Width="140"
                            Height="36"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
